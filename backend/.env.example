POSTGRES_USER=running_club
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=running_club
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://running_club:CHANGE_ME@127.0.0.1:5432/running_club

BASE_URL=http://localhost:5002
OPENAI_API_KEY=CHANGE_ME
LANGFUSE_PUBLIC_KEY=CHANGE_ME
LANGFUSE_SECRET_KEY=CHANGE_ME
LANGFUSE_HOST=CHANGE_ME

# auth
# ENVIRONMENT=development enables non-Secure cookies for plain-http local dev
# and is required for forgot-password to log the reset link instead of emailing it.
ENVIRONMENT=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME
JWT_EXPIRE_MINUTES=10080
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
FRONTEND_BASE_URL=http://localhost:3000

# Langfuse runs only when both keys are configured and tracing is enabled.
# LANGFUSE_HOST above remains supported; LANGFUSE_BASE_URL takes precedence.
LANGFUSE_TRACING_ENABLED=true
# Optional release label (Render uses RENDER_GIT_COMMIT automatically).
# APP_RELEASE=local
